# ==============================================================================
# YUKISHOPMXH — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- PostgreSQL / Supabase Database (Vercel Serverless Persistent Storage) ---
POSTGRES_URL=postgresql://user:password@host:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Site URL / Domain (Required for Auto 2-Way Telegram Webhooks) ---
APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# --- Initial Admin Seed (Optional, hashed automatically; never leave plaintext in code) ---
ADMIN_INITIAL_PASSWORD=choose_a_strong_initial_admin_password

# --- Telegram 2-Way Bots (Shop Control Bot & OTP Password Reset Bot) ---
TELEGRAM_BOT_TOKEN=your_shop_admin_bot_token
TELEGRAM_OTP_BOT_TOKEN=your_otp_reset_bot_token
TELEGRAM_CHAT_ID=your_admin_telegram_chat_id
TELEGRAM_ADMIN_CHAT_ID=your_admin_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_webhook_secret

# --- MacroDroid VietQR Auto Topup Webhook Secret ---
MACRODROID_SECRET=generate_a_long_random_macrodroid_secret

# --- Payment Receiving Account (ZaloPay / VietQR) ---
BANK_CODE=970454
BANK_ID=970454
ACCOUNT_NO=your_receiving_account_number
ACCOUNT_NAME=YOUR_ACCOUNT_HOLDER_NAME
BANK_NAME=ZaloPay (BVBank / VietCapital)

# --- Public Support Channels ---
NEXT_PUBLIC_ADMIN_TELEGRAM=https://t.me/YukiIsMe2311
NEXT_PUBLIC_TELEGRAM_CHANNEL=https://t.me/yukismsnotice

# --- Security & Signing Secrets ---
SESSION_SECRET=generate_at_least_32_random_hex_chars
PASSWORD_SALT=generate_at_least_32_random_hex_chars
JWT_SECRET=generate_at_least_32_random_hex_chars

# --- Cloudflare Turnstile / Captcha (Optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_SECRET=
